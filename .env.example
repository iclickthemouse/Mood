# Do not put browser-exposed production secrets here.
# Current prototype accepts API keys in the in-app settings panel.

# "mood hosted" provider — URL of the deployed mood-proxy worker (see
# worker/wrangler.toml for setup). The Gemini key lives ONLY as an encrypted
# secret on the worker; nothing sensitive ships in the frontend bundle.
# When unset, the hosted card shows as unavailable and the app defaults to
# LM Studio. Setting it also enables the beta-password entry gate on web.
# Example: https://mood-proxy.yourname.workers.dev
VITE_MOOD_PROXY_URL=
